server {

server_name api.gorgeous.ai-info.ru;

access_log /var/log/nginx/boardy-api-access.log;

error_log /var/log/nginx/boardy-api-error.log;

location / {
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

listen 443 ssl;

ssl_certificate /etc/nginx/ssl/gorgeous.crt;
ssl_certificate_key /etc/nginx/ssl/gorgeous.key;

}
